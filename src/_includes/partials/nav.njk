{#- Site header: brand, Products / Resources / Pricing / Company, Sign in, Get started.
	Menus come from site.nav; dropdown width follows item.columns. -#}
<header class="header">
	<div class="header__inner container">
		<a class="brand" href="/">
			<span class="brand__mark" aria-hidden="true">{% icon "phone-square" %}</span>
			{{ site.brand }}
		</a>
		<button
			class="nav-toggle"
			type="button"
			aria-controls="primary-nav"
			aria-expanded="false"
			data-nav-toggle
		>
			<span class="visually-hidden">Toggle navigation</span>
			<span class="nav-toggle__bar" aria-hidden="true"></span>
		</button>
		<nav class="nav" aria-label="Primary">
			<ul id="primary-nav" class="nav__list" data-nav-menu>
				{%- for item in site.nav %}
				{%- if item.alignment == "right" %}
				<li class="nav__divider" aria-hidden="true"></li>
				{%- endif %}
				{%- if item.items %}
				<li class="nav__group" data-nav-dropdown>
					<button
						type="button"
						class="nav__item"
						aria-haspopup="true"
						aria-expanded="false"
						aria-controls="{{ item.id }}"
						data-nav-trigger
					>
						{{ item.label }}
						<svg class="caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" focusable="false"><path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</button>
					<div id="{{ item.id }}" class="dropdown dropdown--cols-{{ item.columns or 2 }}" hidden>
						<ul class="dropdown__grid">
							{%- for sub in item.items %}
							<li>
								<a class="dropdown__item" href="{{ sub.href }}">
									{%- if sub.icon %}
									<span class="dropdown__icon" aria-hidden="true">{% icon sub.icon %}</span>
									{%- endif %}
									<span class="dropdown__text">
										<span class="dropdown__title">{{ sub.label }}</span>
										{%- if sub.description %}
										<span class="dropdown__desc">{{ sub.description }}</span>
										{%- endif %}
									</span>
								</a>
							</li>
							{%- endfor %}
						</ul>
					</div>
				</li>
				{%- else %}
				<li class="nav__group">
					<a class="nav__item{% if page.url === item.href %} is-active{% endif %}" href="{{ item.href }}"{% if page.url === item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
				</li>
				{%- endif %}
				{%- endfor %}
				{%- if site.navCta %}
				<li class="nav__group">
					<a class="nav__cta" href="{{ site.navCta.href }}">{{ site.navCta.label }}</a>
				</li>
				{%- endif %}
			</ul>
		</nav>
	</div>
</header>
