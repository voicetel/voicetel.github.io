{%- for app in phoneApps.apps.concat([phoneApps.fax, phoneApps.messages]) %}
	<h3 class="subsection-heading" id="download-{{ app.key }}">{{ app.name }} {{ app.version }}</h3>
	<div class="prose">
		<p>{{ app.audience }} <a href="{{ phoneApps.baseUrl }}{{ app.releasePage }}">{{ app.name }} release notes and downloads</a>.</p>
	</div>
	<div class="table-container">
		<table class="data-table" aria-labelledby="download-{{ app.key }}">
			<thead>
				<tr><th scope="col">Build</th><th scope="col">SHA-256</th></tr>
			</thead>
			<tbody>
				{%- for file in app.desktop | where("platform", platform) %}
				<tr>
					<td>{{ file.format }} &middot; {{ file.arch }}<br><a href="{{ phoneApps.baseUrl }}{{ file.file | urlencode }}">{{ file.file }}</a> &middot; {{ file.size }}</td>
					<td><code class="mono">{{ file.sha256 | replace(r/^(.{32})/, "$1<wbr>") | safe }}</code></td>
				</tr>
				{%- endfor %}
			</tbody>
		</table>
	</div>
{%- endfor %}
