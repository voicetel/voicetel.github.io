{#- Customer logo strip sits directly above the footer on every page. -#}
<section class="logos-strip" aria-label="Customers">
	<div class="container">
		<p class="logos-strip__label">Trusted by</p>
		<ul class="logos-strip__row">
			{%- for c in customers %}
			<li><img class="logos-strip__logo" src="/assets/logos/{{ c.logo }}" alt="{{ c.name }}" loading="lazy"></li>
			{%- endfor %}
		</ul>
	</div>
</section>
<footer class="footer">
	<div class="container">
		<div class="footer__grid">
			<div class="footer__brand-col">
				<a class="brand" href="/">
					<span class="brand__mark" aria-hidden="true">{% icon "phone-square" %}</span>
					{{ site.brand }}
				</a>
				<p class="footer__tag">{{ site.tagline }}.<br>POPs in {% for c in colocations %}{% if not loop.first %}{% if loop.last %}, and {% else %}, {% endif %}{% endif %}{{ c.city }}{% endfor %}.</p>
				<div class="footer__actions">
					<a class="btn btn--primary btn--sm" href="/signup/">Sign up</a>
					<a class="btn btn--ghost btn--sm" href="{{ site.loginUrl }}">Sign in</a>
				</div>
			</div>
			{%- for group in site.footerNav %}
			<div class="footer__col">
				<h2 class="footer__col-title">{{ group.label }}</h2>
				<ul class="footer__list{% if group.columns == 2 %} footer__list--two-col{% endif %}">
					{%- for item in group.items %}
					<li><a href="{{ item.href }}">{{ item.label }}</a></li>
					{%- endfor %}
				</ul>
			</div>
			{%- endfor %}
		</div>
		<div class="footer__bottom">
			<span>&copy; 1999&ndash;{% year %} <a href="/about/">{{ site.legalName }}</a>. All rights reserved.</span>
			<a class="footer__status" href="/status/">POPs: {{ site.pops | join(" · ") }}</a>
		</div>
	</div>
</footer>
