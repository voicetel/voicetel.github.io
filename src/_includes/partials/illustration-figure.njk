{#- Responsive landing illustration for one landing.tabs entry (`item`). Set
	`eager` when the figure can sit above the fold. -#}
{%- from "partials/landing-illustration-macros.njk" import illustrationHeight, illustrationAlt %}
{%- set ill = item.illustration %}
<figure class="illustration">
	<picture>
		<source media="(min-width: 961px)" srcset="{{ landing.illustrationPath }}{{ item.key }}-wide.svg" width="1000" height="{{ illustrationHeight(ill, 'wide', colocations | length, cloudRegions | length) | trim }}">
		<img src="{{ landing.illustrationPath }}{{ item.key }}-narrow.svg" width="320" height="{{ illustrationHeight(ill, 'narrow', colocations | length, cloudRegions | length) | trim }}" alt="{{ illustrationAlt(ill, colocations, cloudRegions, pricingRuntime) | trim }}"{% if not eager %} loading="lazy"{% endif %} decoding="async">
	</picture>
</figure>
