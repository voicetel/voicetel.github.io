<section class="hero hero--page" aria-labelledby="hero-heading">
	<div class="hero__bg" aria-hidden="true"></div>
	<div class="container hero__inner">
		<div class="hero__copy">
			<p class="eyebrow">SIP trunking</p>
			<h1 id="hero-heading">Carrier SIP trunks for systems you already run.</h1>
			<p class="lede">Connect PBX, UC, contact-center, and SBC environments to VoiceTel for PSTN origination, termination, numbers, emergency-service support, and route controls without replacing your call platform.</p>
			<div class="cta-row">
				<a class="btn btn--primary btn--lg" href="/signup/">Free trial {{ arrow(14) }}</a>
				<a class="btn btn--ghost btn--lg" href="/pricing/#voice-out-us50">See pricing</a>
			</div>
		</div>
		<div class="hero__visual">
			{%- set diagram = {
				title: "SIP trunk from your PBX or SBC through a VoiceTel POP to the PSTN",
				nodes: [
					{ label: "Your platform", value: "PBX · UC · SBC", meta: "Asterisk · FreePBX · FusionPBX", icon: "buildings" },
					{ label: "VoiceTel POP", value: "Anycast · Geocast", meta: "Digest or IP auth", icon: "diagram-3", accent: true },
					{ label: "PSTN", value: "Origination + termination", icon: "telephone" }
				],
				links: [
					{ label: "SIP trunk", both: true, accent: true },
					{ label: "Tier-1", both: true }
				],
				meta: [
					{ k: "Auth", v: "Digest · IP" },
					{ k: "Redundancy", v: "primary + failover trunks" },
					{ k: "E911", v: "tied to numbers" }
				]
			} %}
			{% include "partials/v2/diagram.njk" %}
		</div>
	</div>
</section>

<section class="section section--tint" id="deployments" aria-labelledby="deployments-heading">
	<div class="container">
		<div class="section__head">
			<p class="eyebrow">Deployment</p>
			<h2 id="deployments-heading">Built for practical SIP deployments.</h2>
			<p class="lede">Interop with the platforms you run, registration or IP authentication, redundancy planning, emergency calling tied to numbers, and room for your own SBC.</p>
		</div>
		{%- set features = [
			{ icon: "diagram-3", title: "PBX and UC interop", body: "Use VoiceTel with Asterisk, FreePBX, FreeSWITCH, FusionPBX, SBCs, hosted PBX platforms, and contact centers." },
			{ icon: "box-arrow-in-right", title: "Registration or IP-auth", body: "Connect to VoiceTel's network by Anycast or Geocast. We support Digest and IP authentication methods." },
			{ icon: "activity", title: "Redundancy planning", body: "Route design covers primary and failover trunks, POP preference, number routing, and cutover rollback." },
			{ icon: "shield-check", title: "Emergency calling", body: "Emergency-service configuration is tied to numbers, service addresses, and clear limitations disclosures." },
			{ icon: "plug", title: "BYO SBC", body: "VoiceTel can sit behind customer-owned SBCs where architecture and security requirements call for it." }
		] %}
		{% include "partials/v2/feature-grid.njk" %}
	</div>
</section>

