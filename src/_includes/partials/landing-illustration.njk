{#- Renders one landing illustration as a standalone SVG file. `variant` is
	"wide" (desktop strip, 1000 units across) or "narrow" (stacked layout,
	320 units across) so labels never shrink below a readable size. -#}
{%- from "partials/landing-illustration-macros.njk" import illustrationHeight -%}
{%- set ill = item.illustration %}
{%- set W = 1000 if variant === "wide" else 320 %}
{%- set H = illustrationHeight(ill, variant, colocations | length, cloudRegions | length) | trim %}

{%- macro dialpad(cx, top, sx, sy, r) -%}
{%- for row in range(0, 4) %}{% for col in range(0, 3) %}<circle class="li-key" cx="{{ cx + (col - 1) * sx }}" cy="{{ top + row * sy }}" r="{{ r }}"/>{% endfor %}{% endfor -%}
<circle class="li-call" cx="{{ cx }}" cy="{{ top + 4 * sy + 4 }}" r="{{ r + 1 }}"/>
{%- endmacro -%}

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ W }} {{ H }}" width="{{ W }}" height="{{ H }}">
	<title>{{ ill.title }}</title>
	<style>{{ illustrationStyle | safe }}</style>
	<defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="li-arrow" d="M0,0 L10,5 L0,10 Z"/></marker></defs>
{%- if ill.type === "flow" %}
	{%- set n = ill.nodes | length %}
	{%- if variant === "wide" %}
	{%- set gap = 80 %}
	{%- set w = (984 - gap * (n - 1)) / n %}
	{%- set top = 12 %}
	{%- set h = 92 %}
	{%- set mid = top + h / 2 %}
	{%- for node in ill.nodes %}
	{%- set x = 8 + loop.index0 * (w + gap) %}
	<rect class="li-node{% if node.accent %} li-node--accent{% endif %}" x="{{ x | round(1) }}" y="{{ top }}" width="{{ w | round(1) }}" height="{{ h }}" rx="4"/>
	{%- if node.accent %}
	<rect class="li-accent" x="{{ x | round(1) }}" y="{{ top }}" width="{{ w | round(1) }}" height="3"/>
	{%- endif %}
	<g class="li-icon" transform="translate({{ (x + 14) | round(1) }} {{ top + 16 }}) scale(1.375)">{% icon node.icon %}</g>
	<text class="li-label" x="{{ (x + 14) | round(1) }}" y="{{ top + 62 }}">{{ node.label }}</text>
	<text class="li-meta" x="{{ (x + 14) | round(1) }}" y="{{ top + 81 }}">{{ node.meta }}</text>
	{%- if not loop.last %}
	{%- set link = ill.links[loop.index0] %}
	{%- set x1 = x + w + 6 %}
	{%- set x2 = x + w + gap - 6 %}
	<line class="li-line" x1="{{ x1 | round(1) }}" y1="{{ mid }}" x2="{{ x2 | round(1) }}" y2="{{ mid }}" marker-end="url(#arrow)"{% if link.both %} marker-start="url(#arrow)"{% endif %}/>
	{%- if link.label %}
	<text class="li-link li-halo" x="{{ ((x1 + x2) / 2) | round(1) }}" y="{{ mid - 9 }}" text-anchor="middle">{{ link.label }}</text>
	{%- endif %}
	{%- endif %}
	{%- endfor %}
	{%- if ill.loop %}
	{%- set xa = 8 + w / 2 %}
	{%- set xb = 8 + (n - 1) * (w + gap) + w / 2 %}
	<path class="li-line li-line--return" d="M{{ xb | round(1) }},{{ top + h + 4 }} V{{ top + h + 28 }} H{{ xa | round(1) }} V{{ top + h + 6 }}" marker-end="url(#arrow)"/>
	<text class="li-link" x="{{ ((xa + xb) / 2) | round(1) }}" y="{{ top + h + 48 }}" text-anchor="middle">{{ ill.loop.label }}</text>
	{%- endif %}
	{%- else %}
	{%- set nx = 22 %}
	{%- set nw = 290 %}
	{%- set nh = 60 %}
	{%- set vgap = 40 %}
	{%- set lastTop = 8 + (n - 1) * (nh + vgap) %}
	{%- for node in ill.nodes %}
	{%- set y = 8 + loop.index0 * (nh + vgap) %}
	<rect class="li-node{% if node.accent %} li-node--accent{% endif %}" x="{{ nx }}" y="{{ y }}" width="{{ nw }}" height="{{ nh }}" rx="4"/>
	{%- if node.accent %}
	<rect class="li-accent" x="{{ nx }}" y="{{ y }}" width="3" height="{{ nh }}"/>
	{%- endif %}
	<g class="li-icon" transform="translate({{ nx + 14 }} {{ y + 19 }}) scale(1.375)">{% icon node.icon %}</g>
	<text class="li-label" x="{{ nx + 50 }}" y="{{ y + 26 }}">{{ node.label }}</text>
	<text class="li-meta" x="{{ nx + 50 }}" y="{{ y + 45 }}">{{ node.meta }}</text>
	{%- if not loop.last %}
	{%- set link = ill.links[loop.index0] %}
	<line class="li-line" x1="{{ nx + nw / 2 }}" y1="{{ y + nh + 5 }}" x2="{{ nx + nw / 2 }}" y2="{{ y + nh + vgap - 5 }}" marker-end="url(#arrow)"{% if link.both %} marker-start="url(#arrow)"{% endif %}/>
	{%- if link.label %}
	<text class="li-link" x="{{ nx + nw / 2 + 12 }}" y="{{ y + nh + vgap / 2 + 4 }}">{{ link.label }}</text>
	{%- endif %}
	{%- endif %}
	{%- endfor %}
	{%- if ill.loop %}
	<path class="li-line li-line--return" d="M{{ nx }},{{ lastTop + nh / 2 }} H8 V{{ 8 + nh / 2 }} H{{ nx - 3 }}" marker-end="url(#arrow)"/>
	<text class="li-link" x="{{ nx }}" y="{{ lastTop + nh + 24 }}">{{ ill.loop.label }}</text>
	{%- endif %}
	{%- endif %}

{%- elif ill.type === "network" %}
	{%- set popRows = ((colocations | length) / 2) | round(0, "ceil") %}
	{%- if variant === "wide" %}
	<path class="li-land" d="{{ ill.outline }}"/>
	{%- for region in cloudRegions %}
	{%- set pt = ill.points[region.code] %}
	{%- if pt %}
	<rect class="li-region" x="{{ pt.x - 5 }}" y="{{ pt.y - 5 }}" width="10" height="10"/>
	<text class="li-meta li-halo" x="{{ pt.lx }}" y="{{ pt.ly }}" text-anchor="{{ pt.anchor or 'start' }}">{{ region.awsCode }}</text>
	{%- endif %}
	{%- endfor %}
	{%- for pop in colocations %}
	{%- set pt = ill.points[pop.code] %}
	{%- if pt %}
	<circle class="li-pop-ring" cx="{{ pt.x }}" cy="{{ pt.y }}" r="12"/>
	<circle class="li-pop" cx="{{ pt.x }}" cy="{{ pt.y }}" r="6"/>
	<text class="li-code li-halo" x="{{ pt.lx }}" y="{{ pt.ly }}" text-anchor="{{ pt.anchor or 'start' }}">{{ pop.code }}</text>
	{%- endif %}
	{%- endfor %}
	<circle class="li-pop" cx="586" cy="34" r="5"/>
	<text class="li-heading" x="600" y="39">Colocation POPs</text>
	{%- for pop in colocations %}
	{%- set x = 580 + (loop.index0 % 2) * 210 %}
	{%- set y = 70 + ((loop.index0 / 2) | int) * 24 %}
	<text class="li-code" x="{{ x }}" y="{{ y }}">{{ pop.code }}</text>
	<text class="li-meta" x="{{ x + 44 }}" y="{{ y }}">{{ pop.city }}{% if pop.country !== "USA" %}, {{ pop.country }}{% endif %}</text>
	{%- endfor %}
	{%- set regionTop = 70 + popRows * 24 + 22 %}
	<rect class="li-region" x="581" y="{{ regionTop - 10 }}" width="10" height="10"/>
	<text class="li-heading" x="600" y="{{ regionTop }}">Cloud regions</text>
	{%- for region in cloudRegions %}
	<text class="li-code" x="580" y="{{ regionTop + 32 + loop.index0 * 24 }}">{{ region.awsCode }}</text>
	<text class="li-meta" x="668" y="{{ regionTop + 32 + loop.index0 * 24 }}">{{ region.geo }}</text>
	{%- endfor %}
	{%- else %}
	{%- set s = 0.6 %}
	{%- set listTop = 6 + 282 * s + 22 %}
	{%- set regionTop = listTop + 26 + popRows * 22 + 14 %}
	<path class="li-land" d="{{ ill.outline }}" transform="translate(10 6) scale({{ s }})" vector-effect="non-scaling-stroke"/>
	{%- for region in cloudRegions %}
	{%- set pt = ill.points[region.code] %}
	{%- if pt %}
	<rect class="li-region" x="{{ (10 + pt.x * s - 3.5) | round(1) }}" y="{{ (6 + pt.y * s - 3.5) | round(1) }}" width="7" height="7"/>
	{%- endif %}
	{%- endfor %}
	{%- for pop in colocations %}
	{%- set pt = ill.points[pop.code] %}
	{%- if pt %}
	<circle class="li-pop-ring" cx="{{ (10 + pt.x * s) | round(1) }}" cy="{{ (6 + pt.y * s) | round(1) }}" r="8"/>
	<circle class="li-pop" cx="{{ (10 + pt.x * s) | round(1) }}" cy="{{ (6 + pt.y * s) | round(1) }}" r="4"/>
	<text class="li-code li-halo" x="{{ (10 + pt.lx * s) | round(1) }}" y="{{ (6 + pt.ly * s) | round(1) }}" text-anchor="{{ pt.anchor or 'start' }}">{{ pop.code }}</text>
	{%- endif %}
	{%- endfor %}
	<circle class="li-pop" cx="14" cy="{{ listTop - 4 }}" r="4"/>
	<text class="li-heading" x="26" y="{{ listTop }}">Colocation POPs</text>
	{%- for pop in colocations %}
	{%- set x = 10 + (loop.index0 % 2) * 155 %}
	{%- set y = listTop + 26 + ((loop.index0 / 2) | int) * 22 %}
	<text class="li-code" x="{{ x }}" y="{{ y }}">{{ pop.code }}</text>
	<text class="li-meta" x="{{ x + 38 }}" y="{{ y }}">{{ pop.city }}</text>
	{%- endfor %}
	<rect class="li-region" x="10" y="{{ regionTop - 8 }}" width="8" height="8"/>
	<text class="li-heading" x="26" y="{{ regionTop }}">Cloud regions</text>
	{%- for region in cloudRegions %}
	<text class="li-code" x="10" y="{{ regionTop + 26 + loop.index0 * 22 }}">{{ region.awsCode }}</text>
	<text class="li-meta" x="96" y="{{ regionTop + 26 + loop.index0 * 22 }}">{{ region.geo }}</text>
	{%- endfor %}
	{%- endif %}

{%- elif ill.type === "curve" %}
	{%- set curve = pricingRuntime | rateCurve(ill.service) %}
	{%- set maxRate = curve[0][1] %}
	{%- set floorRate = pricingRuntime | volumeRateValue(ill.service, ill.maxVolume) %}
	{%- if variant === "wide" %}
	{%- set floorY = (210 - floorRate / maxRate * 170) | round(1) %}
	<line class="li-grid" x1="80" y1="40" x2="650" y2="40"/>
	<line class="li-grid" x1="80" y1="{{ floorY }}" x2="650" y2="{{ floorY }}"/>
	<line class="li-axis" x1="80" y1="24" x2="80" y2="210"/>
	<line class="li-axis" x1="80" y1="210" x2="650" y2="210"/>
	<text class="li-meta" x="72" y="44" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, 0) }}</text>
	<text class="li-meta" x="72" y="{{ floorY + 4 }}" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, ill.maxVolume) }}</text>
	{%- for i in range(0, 6) %}
	<line class="li-axis" x1="{{ 80 + i * 112 }}" y1="210" x2="{{ 80 + i * 112 }}" y2="215"/>
	<text class="li-meta" x="{{ 80 + i * 112 }}" y="232" text-anchor="middle">{{ i }}{% if i > 0 %}M{% endif %}</text>
	{%- endfor %}
	<text class="li-link" x="650" y="252" text-anchor="end">minutes / month</text>
	<path class="li-curve" d="{% for p in curve %}{% if p[0] <= ill.maxVolume %}{{ 'M' if loop.first else ' L' }}{{ (80 + p[0] / ill.maxVolume * 560) | round(1) }},{{ (210 - p[1] / maxRate * 170) | round(1) }}{% endif %}{% endfor %}"/>
	{%- for mark in ill.marks %}
	{%- set mx = 80 + mark.volume / ill.maxVolume * 560 %}
	{%- set my = 210 - (pricingRuntime | volumeRateValue(ill.service, mark.volume)) / maxRate * 170 %}
	<circle class="li-dot" cx="{{ mx | round(1) }}" cy="{{ my | round(1) }}" r="5"/>
	{%- if mark.volume > 0 %}
	<text class="li-link li-halo" x="{{ (mx - 10 if loop.last else mx + 10) | round(1) }}" y="{{ (my - 10) | round(1) }}" text-anchor="{{ 'end' if loop.last else 'start' }}">{{ pricingRuntime | volumeRate(ill.service, mark.volume) }}</text>
	{%- endif %}
	{%- endfor %}
	<text class="li-heading" x="700" y="44">Rate per minute</text>
	{%- for mark in ill.marks %}
	{%- set y = 82 + loop.index0 * 40 %}
	<text class="li-meta" x="700" y="{{ y }}">{{ mark.label }}</text>
	<text class="li-label" x="990" y="{{ y }}" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, mark.volume) }}</text>
	<line class="li-grid" x1="700" y1="{{ y + 14 }}" x2="990" y2="{{ y + 14 }}"/>
	{%- endfor %}
	{%- else %}
	{%- set floorY = (150 - floorRate / maxRate * 120) | round(1) %}
	<line class="li-grid" x1="58" y1="30" x2="306" y2="30"/>
	<line class="li-grid" x1="58" y1="{{ floorY }}" x2="306" y2="{{ floorY }}"/>
	<line class="li-axis" x1="58" y1="16" x2="58" y2="150"/>
	<line class="li-axis" x1="58" y1="150" x2="306" y2="150"/>
	<text class="li-tick" x="52" y="34" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, 0) }}</text>
	<text class="li-tick" x="52" y="{{ floorY + 4 }}" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, ill.maxVolume) }}</text>
	{%- for i in range(0, 6) %}
	<text class="li-tick" x="{{ 58 + i * 48 }}" y="168" text-anchor="middle">{{ i }}{% if i > 0 %}M{% endif %}</text>
	{%- endfor %}
	<text class="li-tick" x="306" y="184" text-anchor="end">minutes / month</text>
	<path class="li-curve" d="{% for p in curve %}{% if p[0] <= ill.maxVolume %}{{ 'M' if loop.first else ' L' }}{{ (58 + p[0] / ill.maxVolume * 240) | round(1) }},{{ (150 - p[1] / maxRate * 120) | round(1) }}{% endif %}{% endfor %}"/>
	{%- for mark in ill.marks %}
	<circle class="li-dot" cx="{{ (58 + mark.volume / ill.maxVolume * 240) | round(1) }}" cy="{{ (150 - (pricingRuntime | volumeRateValue(ill.service, mark.volume)) / maxRate * 120) | round(1) }}" r="4"/>
	{%- endfor %}
	{%- for mark in ill.marks %}
	{%- set y = 206 + loop.index0 * 30 %}
	<text class="li-meta" x="8" y="{{ y }}">{{ mark.label }}</text>
	<text class="li-label" x="312" y="{{ y }}" text-anchor="end">{{ pricingRuntime | volumeRate(ill.service, mark.volume) }}</text>
	<line class="li-grid" x1="8" y1="{{ y + 12 }}" x2="312" y2="{{ y + 12 }}"/>
	{%- endfor %}
	{%- endif %}

{%- elif ill.type === "devices" %}
	{%- if variant === "wide" %}
	{%- for device in ill.devices %}
	{%- set cx = 180 + loop.index0 * 320 %}
	{%- if device.kind === "browser" %}
	<rect class="li-device" x="{{ cx - 100 }}" y="12" width="200" height="130" rx="6"/>
	<line class="li-device-rule" x1="{{ cx - 100 }}" y1="36" x2="{{ cx + 100 }}" y2="36"/>
	<circle class="li-key" cx="{{ cx - 86 }}" cy="24" r="3"/><circle class="li-key" cx="{{ cx - 76 }}" cy="24" r="3"/><circle class="li-key" cx="{{ cx - 66 }}" cy="24" r="3"/>
	{{ dialpad(cx, 52, 22, 18, 6) }}
	{%- elif device.kind === "desktop" %}
	<rect class="li-device" x="{{ cx - 90 }}" y="12" width="180" height="112" rx="6"/>
	<path class="li-device" d="M{{ cx - 110 }},128 H{{ cx + 110 }} L{{ cx + 100 }},140 H{{ cx - 100 }} Z"/>
	{{ dialpad(cx, 32, 22, 17, 6) }}
	{%- else %}
	<rect class="li-device" x="{{ cx - 36 }}" y="8" width="72" height="136" rx="12"/>
	<line class="li-device-rule" x1="{{ cx - 10 }}" y1="18" x2="{{ cx + 10 }}" y2="18"/>
	<line class="li-device-rule" x1="{{ cx - 14 }}" y1="136" x2="{{ cx + 14 }}" y2="136"/>
	{{ dialpad(cx, 38, 18, 16, 5) }}
	{%- endif %}
	<text class="li-label" x="{{ cx }}" y="168" text-anchor="middle">{{ device.label }}</text>
	<text class="li-meta" x="{{ cx }}" y="188" text-anchor="middle">{{ device.meta }}</text>
	<line class="li-line" x1="{{ cx }}" y1="198" x2="{{ cx }}" y2="208"/>
	{%- endfor %}
	<line class="li-line" x1="180" y1="208" x2="820" y2="208"/>
	<line class="li-line" x1="500" y1="208" x2="500" y2="220"/>
	<rect class="li-node li-node--accent" x="340" y="220" width="320" height="46" rx="4"/>
	<rect class="li-accent" x="340" y="220" width="320" height="3"/>
	<text class="li-label" x="500" y="240" text-anchor="middle">{{ ill.hub.label }}</text>
	<text class="li-meta" x="500" y="258" text-anchor="middle">{{ ill.hub.meta }}</text>
	{%- else %}
	{%- set hubTop = 8 + (ill.devices | length) * 92 %}
	{%- for device in ill.devices %}
	{%- set y = 8 + loop.index0 * 92 %}
	{%- if device.kind === "browser" %}
	<rect class="li-device" x="12" y="{{ y + 6 }}" width="80" height="62" rx="4"/>
	<line class="li-device-rule" x1="12" y1="{{ y + 18 }}" x2="92" y2="{{ y + 18 }}"/>
	{{ dialpad(52, y + 28, 11, 7, 2.5) }}
	{%- elif device.kind === "desktop" %}
	<rect class="li-device" x="20" y="{{ y + 4 }}" width="64" height="50" rx="3"/>
	<path class="li-device" d="M12,{{ y + 58 }} H92 L88,{{ y + 64 }} H16 Z"/>
	{{ dialpad(52, y + 13, 10, 7, 2.5) }}
	{%- else %}
	<rect class="li-device" x="37" y="{{ y + 2 }}" width="30" height="66" rx="6"/>
	{{ dialpad(52, y + 16, 8, 7, 2.5) }}
	{%- endif %}
	<text class="li-label" x="108" y="{{ y + 30 }}">{{ device.label }}</text>
	<text class="li-meta" x="108" y="{{ y + 50 }}">{{ device.meta }}</text>
	<line class="li-line" x1="298" y1="{{ y + 36 }}" x2="308" y2="{{ y + 36 }}"/>
	{%- endfor %}
	<line class="li-line" x1="308" y1="44" x2="308" y2="{{ hubTop }}"/>
	<rect class="li-node li-node--accent" x="8" y="{{ hubTop }}" width="304" height="48" rx="4"/>
	<rect class="li-accent" x="8" y="{{ hubTop }}" width="3" height="48"/>
	<text class="li-label" x="22" y="{{ hubTop + 20 }}">{{ ill.hub.label }}</text>
	<text class="li-meta" x="22" y="{{ hubTop + 39 }}">{{ ill.hub.meta }}</text>
	{%- endif %}
{%- endif %}
</svg>
