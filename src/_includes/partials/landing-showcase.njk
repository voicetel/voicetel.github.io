{%- from "partials/landing-illustration-macros.njk" import illustrationHeight, illustrationAlt %}
<section class="landing-showcase" aria-label="Explore VoiceTel" data-landing-showcase>
	<div class="container">
		<div class="landing-tabs" data-landing-tabs hidden>
			{%- for item in landing.tabs %}
			<button type="button" id="landing-tab-{{ item.key }}" data-landing-tab>{{ item.label }}</button>
			{%- endfor %}
		</div>
		<div class="landing-panels">
			{%- for item in landing.tabs %}
			<section class="landing-panel{% if loop.first %} landing-panel--hero{% endif %}" id="landing-panel-{{ item.key }}" aria-labelledby="landing-heading-{{ item.key }}" data-landing-panel>
				<div class="landing-copy">
					<p class="landing-eyebrow">{{ item.eyebrow }}</p>
					{% if loop.first %}<h1 id="landing-heading-{{ item.key }}">{{ item.title }}</h1>
					{% else %}<h2 id="landing-heading-{{ item.key }}">{{ item.title }}</h2>{% endif %}
					<p class="landing-description">{{ item.description }}</p>
					<p class="landing-actions">
						<a class="btn btn-primary" href="{{ item.href }}">{{ item.cta }}{% if not loop.first %} &rarr;{% endif %}</a>
						{%- if item.secondaryHref %}
						<a class="btn btn-secondary" href="{{ item.secondaryHref }}">{{ item.secondaryCta }}</a>
						{%- endif %}
					</p>
				</div>
				<div class="landing-figure">
					{% include "partials/landing-figure.njk" %}
				</div>
				{%- set ill = item.illustration %}
				<figure class="landing-illustration">
					<picture>
						<source media="(min-width: 961px)" srcset="{{ landing.illustrationPath }}{{ item.key }}-wide.svg" width="1000" height="{{ illustrationHeight(ill, 'wide', colocations | length, cloudRegions | length) | trim }}">
						<img src="{{ landing.illustrationPath }}{{ item.key }}-narrow.svg" width="320" height="{{ illustrationHeight(ill, 'narrow', colocations | length, cloudRegions | length) | trim }}" alt="{{ illustrationAlt(ill, colocations, cloudRegions, pricingRuntime) | trim }}"{% if not loop.first %} loading="lazy"{% endif %} decoding="async">
					</picture>
				</figure>
			</section>
			{%- endfor %}
		</div>
	</div>
</section>
