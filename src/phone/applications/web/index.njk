---
layout: layouts/tool.njk
permalink: /phone/applications/web/
title: "VoiceTel Phone — Web client"
description: "Browser-based VoIP calling for VoiceTel — SIP over WebSocket, WebRTC media. Sign in with your VoiceTel SIP credentials and place a call from any modern browser."
eleventyExcludeFromCollections: true
---

<link rel="stylesheet" href="/assets/css/phone-web.css?v={{ assetVersion }}">

<p class="eyebrow"><a href="/phone/">VoiceTel Phone</a> &middot; Web</p>
<h1>Calling in the browser. No install.</h1>
<p class="lede">Sign in below with your VoiceTel SIP credentials and place a call. The web client runs entirely in the browser using SIP-over-WebSocket signaling and WebRTC media — useful for quick calls, lightweight setups, and any environment where installing a desktop or mobile app isn't an option. Everything is stored in your browser, 100%.</p>
<p class="hero-actions">
	<a class="btn btn-primary" href="/signup/">Sign up</a>
	<a class="btn btn-secondary" href="/phone/applications/">All applications</a>
</p>

{%- set phoneApp = phoneApps.apps | where("key", "voicetel") | first %}
<script>
	try {
					var t = localStorage.getItem("voicetel_theme");
					if (t === "light" || t === "dark")
						document.documentElement.setAttribute("data-theme", t);
				} catch (e) {
					/* storage disabled — fall back to system theme */
				}
</script>

<div class="phone-app">
		<div class="container">
			<div class="header">
				<div class="header-buttons">
					<button
						class="header-toggle active"
						onclick="showPhone()"
						title="Phone"
					>
						📞
					</button>
					<button
						class="header-toggle"
						onclick="showContacts()" hidden
						title="Contacts"
					>
						👥
					</button>
					<button
						class="header-toggle"
						onclick="showHistory()"
						title="Call History"
					>
						📜
					</button>
					<button
						class="header-toggle"
						onclick="showLog()"
						title="Event Log"
					>
						📋
					</button>
					<button
						class="header-toggle"
						onclick="showSettings()"
						title="Settings"
					>
						⚙️
					</button>
				</div>
				<p class="app-title">
					<span class="brand-icon" aria-hidden="true"
						><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
							<path
								d="M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V96c0-35.3-28.7-64-64-64H64zm90.7 96.7c9.7-2.6 19.9 2.3 23.7 11.6l20 48c3.4 8.2 1 17.6-5.8 23.2L168 231.7c16.6 35.2 45.1 63.7 80.3 80.3l20.2-24.7c5.6-6.8 15-9.2 23.2-5.8l48 20c9.3 3.9 14.2 14 11.6 23.7l-12 44C336.9 378 329 384 320 384C196.3 384 96 283.7 96 160c0-9 6-16.9 14.7-19.3l44-12z"
							/></svg
					></span>
					VoiceTel
				</p>
				<div id="status" class="status">Disconnected</div>
			</div>

			<div class="content">
				<div class="section config-section" id="configSection">
					<h2>Settings</h2>

					<div class="button-group" style="margin-bottom: 20px">
						<button
							id="registerBtn"
							class="btn-primary"
							onclick="register()"
						>
							Register
						</button>
						<button
							id="unregisterBtn"
							class="btn-secondary"
							onclick="unregister()"
							disabled
						>
							Unregister
						</button>
					</div>

					<input type="hidden" id="sipServer" value="" />

					<div class="form-group">
						<label>
							Username
							<small style="color: var(--text-hint)"
								>Must be exactly 10 digits (your phone
								number)</small
							>
						</label>
						<input
							type="tel"
							id="username"
							placeholder="e.g. 5551234567"
							maxlength="10"
							required
							inputmode="numeric"
						/>
						<small
							id="usernameError"
							style="
								color: var(--danger-text);
								display: none;
								margin-top: 5px;
							"
						>
							Username must be exactly 10 numeric digits
						</small>
					</div>

					<div class="form-group">
						<label>Password</label>
						<input
							type="password"
							id="password"
							placeholder="password"
							autocomplete="current-password"
							spellcheck="false"
						/>
					</div>

					<div class="form-group">
						<label>Display Name</label>
						<input
							type="text"
							id="displayName"
							placeholder="Your Name"
						/>
					</div>

					<div class="form-group">
						<label>
							Caller ID Number
							<small style="color: var(--text-hint)"
								>Optional — international (E.164, e.g.
								+447700900123) or a 10-digit North American
								number</small
							>
						</label>
						<input
							type="tel"
							id="callerID"
							placeholder="e.g. +18005551234"
							maxlength="16"
							inputmode="tel"
						/>
						<small
							id="callerIDError"
							style="
								color: var(--danger-text);
								display: none;
								margin-top: 5px;
							"
						>
							Please enter a valid 10-digit North American phone
							number
						</small>
					</div>

					<div
						class="form-group"
						style="
							background: var(--surface-alt);
							padding: 15px;
							border-radius: 8px;
							margin-top: 20px;
						"
					>
						<label
							style="
								display: flex;
								align-items: center;
								cursor: pointer;
								color: var(--primary-light);
								font-weight: 600;
							"
						>
							<input
								type="checkbox"
								id="saveCredentials"
								style="width: auto; margin-right: 8px"
							/>
							Save credentials
						</label>
						<small
							style="color: var(--text-hint); display: block; margin-top: 8px"
						>
							💾 Credentials are saved in local storage
						</small>

						<label
							style="
								display: flex;
								align-items: center;
								cursor: pointer;
								color: var(--primary-light);
								font-weight: 600;
								margin-top: 20px;
							"
						>
							<input type="checkbox" id="registerOnStartup" />
							<span>Register automatically</span>
						</label>
						<small
							style="color: var(--text-hint); display: block; margin-top: 8px"
						>
							🤖 Register automatically on startup
						</small>

						<label
							style="
								display: flex;
								align-items: center;
								cursor: pointer;
								color: var(--primary-light);
								font-weight: 600;
								margin-top: 20px;
							"
						>
							<input type="checkbox" id="hideEventLog" />
							<span>Hide Event Log</span>
						</label>
						<small
							style="color: var(--text-hint); display: block; margin-top: 8px"
						>
							👁️ Hide the event log from the main interface
						</small>

						<label
							for="themeSelect"
							style="
								display: block;
								color: var(--primary-light);
								font-weight: 600;
								margin-top: 20px;
							"
						>
							🎨 Appearance
						</label>
						<select
							id="themeSelect"
							class="appearance-select"
							style="width: 100%; margin-top: 8px; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--paper); color: var(--text-default); font-size: 16px; cursor: pointer"
						>
							<option value="system">System</option>
							<option value="light">Light</option>
							<option value="dark">Dark</option>
						</select>

						<div
							class="storage-info"
							style="display: none"
							id="storageInfo"
						>
							Settings saved locally on this device
						</div>

						<button
							class="btn-secondary"
							onclick="clearAllData()"
							style="
								margin-top: 10px;
								padding: 8px 16px;
								font-size: 12px;
							"
						>
							Clear All Saved Data
						</button>
					</div>
				</div>

				<div class="section hideable" id="callSection">
					<div id="incomingCall" class="incoming-call">
						<div
							style="
								text-align: center;
								font-size: 32px;
								margin-bottom: 10px;
							"
						>
							📞
						</div>
						<div class="incoming-caller" id="incomingCallerName">
							Incoming Call
						</div>
						<div class="incoming-number" id="incomingCallerNumber">
							Unknown Number
						</div>
						<div class="incoming-buttons">
							<button class="btn-answer" onclick="answerCall()">
								✔ Answer
							</button>
							<button class="btn-decline" onclick="declineCall()">
								✗ Decline
							</button>
						</div>
						<div
							style="
								text-align: center;
								margin-top: 10px;
								font-size: 11px;
								opacity: 0.8;
							"
						>
							Press Enter to answer • Escape to decline
						</div>
					</div>

					<div id="dialpadLayer" class="dialpad-layer">
					<div class="form-group">
						<input
							type="text"
							id="callNumber"
							placeholder="Enter number to dial / DTMF during call"
							inputmode="numeric"
						/>
					</div>

					<div class="dialpad">
						<button onclick="appendNumber('1')">1</button>
						<button onclick="appendNumber('2')">2</button>
						<button onclick="appendNumber('3')">3</button>
						<button onclick="appendNumber('4')">4</button>
						<button onclick="appendNumber('5')">5</button>
						<button onclick="appendNumber('6')">6</button>
						<button onclick="appendNumber('7')">7</button>
						<button onclick="appendNumber('8')">8</button>
						<button onclick="appendNumber('9')">9</button>
						<button onclick="appendNumber('*')">*</button>
						<button onclick="appendNumber('0')">0</button>
						<button onclick="appendNumber('#')">#</button>
					</div>

					<div class="button-group">
						<button
							id="callBtn"
							class="btn-success"
							onclick="makeCall()"
							disabled
						>
							📞 Call
						</button>
							<button
								class="btn-secondary"
								onclick="clearNumber()"
							>
							Clear
						</button>
						</div>
					</div>

					<div id="callControls" class="call-controls">
						<div class="call-info">
							<div id="callStatus">Call in progress</div>
							<div id="callDuration">00:00</div>
						</div>
						<div id="ringingIndicator">🔔 Ringing...</div>
						<!-- In-call control grid (mobile 3.8.4 parity): Mute / Hold,
						     Transfer / Refresh Mic, Dialpad / Hang Up. Dialpad toggles
						     the keypad (DTMF) and is shown only while a call is up. -->
						<div
							style="
								display: grid;
								grid-template-columns: 1fr 1fr;
								gap: 8px;
								max-width: 300px;
								margin: 15px auto 0;
							"
						>
							<button
								id="muteBtn"
								class="btn-secondary"
								style="min-width: 0"
								onclick="toggleMute()"
							>
								Mute
							</button>
							<button
								id="holdBtn"
								class="btn-secondary"
								style="min-width: 0"
								onclick="toggleHold()"
							>
								Hold
							</button>
							<button
								id="transferBtn"
								class="btn-secondary"
								style="min-width: 0"
								onclick="transferCall()"
							>
								Transfer
							</button>
							<button
								id="refreshMicBtn"
								class="btn-secondary"
								style="min-width: 0"
								onclick="refreshMicrophoneTrack()"
							>
								Refresh Mic
							</button>
							<button
								id="showDialpadBtn"
								class="btn-secondary"
								style="min-width: 0; display: none"
								onclick="toggleInCallDialpad()"
							>
								Dialpad
							</button>
							<button
								id="hangupBtn"
								class="btn-danger"
								style="min-width: 0"
								onclick="hangup()"
							>
								Hang Up
							</button>
						</div>
					</div>
				</div>

				<div class="section log-section" id="logSection">
					<h2>Event Log</h2>
					<div id="log" class="log"></div>
					<div
						style="
							text-align: center;
							margin-top: 10px;
							color: var(--text-hint);
							font-size: 12px;
						"
					>
						WebSocket: Loading... | SIP Domain: Loading...
					</div>

					<details
						style="
							margin-top: 15px;
							padding: 10px;
							background: var(--surface-alt);
							border-radius: 8px;
						"
					>
						<summary
							style="
								cursor: pointer;
								color: var(--primary-light);
								font-weight: 600;
							"
						>
							⚠️ Troubleshooting Tips
						</summary>
						<div
							style="
								margin-top: 10px;
								font-size: 13px;
								color: var(--text-soft);
								line-height: 1.6;
							"
						>
							<ul style="margin-left: 20px">
								<li>
									Ensure microphone permissions are granted
								</li>
								<li>
									Try using Chrome or Firefox (latest
									versions)
								</li>
								<li>
									Check that your firewall allows WebRTC
									traffic
								</li>
								<li>Disable VPN if you're using one</li>
							</ul>
							<p style="margin-top: 10px">
								<strong
									>Need assistance? Contact the
									<a href="mailto:support@voicetel.com"
										>VoiceTel Support Team</a
									></strong
								>
							</p>
						</div>
					</details>
				</div>

				<div class="section log-section" id="contactsSection" hidden>
					<h2>Contacts</h2>
					<div class="contacts-search" style="margin-bottom: 15px">
						<input
							type="text"
							id="contactSearch"
							placeholder="🔍 Search contacts..."
							class="input-field"
							oninput="filterContacts()"
							style="
								width: 100%;
								padding: 12px 16px;
								border: 2px solid var(--input-border);
								border-radius: 25px;
								font-size: 14px;
								background: var(--light-bg);
								transition: all 0.3s ease;
								outline: none;
							"
							onfocus="this.style.borderColor='var(--accent)'; this.style.backgroundColor='var(--paper)'; this.style.boxShadow='0 0 0 3px rgba(0,123,255,0.1)';"
							onblur="this.style.borderColor='var(--input-border)'; this.style.backgroundColor='var(--light-bg)'; this.style.boxShadow='none';"
						/>
					</div>
					<div
						id="googleAuthSection"
						style="margin-bottom: 20px; text-align: center"
					>
						<div id="notSignedIn">
							<p style="margin-bottom: 10px; color: var(--text-soft)">
								Sign in with Google to access your contacts
							</p>
							<button
								class="btn-primary"
								onclick="signInWithGoogle()"
							>
								🔐 Sign in with Google
							</button>
						</div>
						<div id="signedIn" style="display: none">
							<p style="margin-bottom: 10px; color: var(--text-soft)">
								<span id="userEmail"></span>
							</p>
							<button
								class="btn-secondary"
								onclick="signOutGoogle()"
							>
								Sign Out
							</button>
							<button
								class="btn-primary"
								onclick="loadGoogleContacts()"
								style="margin-left: 10px"
							>
								🔄 Refresh Contacts
							</button>
						</div>
					</div>
					<div id="contactsList" class="log"></div>
					<div class="contacts-actions">
						<button class="btn-secondary" onclick="loadContacts()">
							<span>🔄</span> <span>Refresh</span>
						</button>
						<button class="btn-secondary" onclick="clearContacts()">
							<span>🗑️</span> <span>Clear</span>
						</button>
					</div>
				</div>

				<div class="section log-section" id="historySection">
					<h2>Call History</h2>
					<div id="callHistory" class="log"></div>
					<div class="history-actions">
						<button
							class="btn-secondary"
							onclick="renderCallHistory()"
						>
							<span>🔄</span> <span>Refresh</span>
						</button>
						<button class="btn-secondary" onclick="clearHistory()">
							<span>🗑️</span> <span>Clear History</span>
						</button>
					</div>
				</div>
			</div>

			<div class="audio-container">
				<audio id="remoteAudio" autoplay playsinline></audio>
				<audio id="localAudio" autoplay muted playsinline></audio>
			</div>
		</div>
</div>

<aside class="cta-block" aria-labelledby="web-cta-heading">
	<h2 id="web-cta-heading">Get credentials and start calling right now from this page.</h2>
	<p>Sign up to provision an account. As soon as your SIP credentials are issued you can paste them into the panel above and place a real call straight from this browser tab &mdash; no install, no extension.</p>
	<p class="hero-actions">
		<a class="btn btn-primary" href="/signup/">Sign up &amp; get credentials</a>
		<a class="btn btn-secondary" href="{{ site.loginUrl }}" rel="external">Already a customer? Sign in</a>
	</p>
</aside>

<script>window.VOICETEL_CONFIG = { version: "{{ phoneApp.version }}" };</script>
<script src="https://cdn.jsdelivr.net/npm/sip.js@0.15.11/dist/sip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/localforage@1.10.0/dist/localforage.min.js"></script>
<script src="/assets/js/phone-web-helpers.js?v={{ assetVersion }}"></script>
<script src="/assets/js/phone-web.js?v={{ assetVersion }}"></script>
