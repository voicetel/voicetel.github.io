{#- Shared by the homepage <picture> markup and the generated SVG files so the
	declared image size and the alt text always match the drawing. -#}

{%- macro illustrationHeight(ill, variant, popCount, regionCount) -%}
{%- if ill.type === "flow" -%}
{%- if variant === "wide" -%}{{ 160 if ill.loop else 116 }}{%- else -%}{{ 68 + ((ill.nodes | length) - 1) * 100 + (34 if ill.loop else 8) }}{%- endif -%}
{%- elif ill.type === "network" -%}
{%- if variant === "wide" -%}300{%- else -%}{{ (6 + 282 * 0.6 + 22 + 26 + ((popCount / 2) | round(0, "ceil")) * 22 + 14 + 20 + regionCount * 22) | round(0, "ceil") }}{%- endif -%}
{%- elif ill.type === "curve" -%}
{%- if variant === "wide" -%}260{%- else -%}{{ 200 + (ill.marks | length) * 30 }}{%- endif -%}
{%- elif ill.type === "devices" -%}
{%- if variant === "wide" -%}272{%- else -%}{{ 64 + (ill.devices | length) * 92 }}{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro illustrationAlt(ill, colocations, cloudRegions, pricing) -%}
{{ ill.title }}.
{%- if ill.type === "flow" %} {% for node in ill.nodes %}{{ node.label }} ({{ node.meta }}){% if not loop.last %}, then {% endif %}{% endfor %}.{% if ill.loop %} {{ ill.loop.label }}.{% endif %}
{%- elif ill.type === "network" %} Colocation POPs: {% for pop in colocations %}{{ pop.city }} ({{ pop.code }}){% if not loop.last %}, {% endif %}{% endfor %}. Cloud regions: {% for region in cloudRegions %}{{ region.awsCode }} ({{ region.geo }}){% if not loop.last %}, {% endif %}{% endfor %}.
{%- elif ill.type === "curve" %} {% for mark in ill.marks %}{{ mark.label }}: {{ pricing | volumeRate(ill.service, mark.volume) }} per minute{% if not loop.last %}; {% endif %}{% endfor %}.
{%- elif ill.type === "devices" %} {% for device in ill.devices %}{{ device.label }} ({{ device.meta }}){% if not loop.last %}, {% endif %}{% endfor %}, each signing in with {{ ill.hub.label }} ({{ ill.hub.meta }}).
{%- endif -%}
{%- endmacro -%}
