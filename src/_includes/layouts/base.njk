<!DOCTYPE html>
<html lang="{{ site.lang or 'en' }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }} — {{ site.tagline }}{% endif %}</title>
		<meta name="description" content="{{ description or site.description }}">
		<link rel="canonical" href="{{ site.url }}{{ page.url }}">
		<meta property="og:title" content="{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }} — {{ site.tagline }}{% endif %}">
		<meta property="og:description" content="{{ description or site.description }}">
		<meta property="og:url" content="{{ site.url }}{{ page.url }}">
		<meta property="og:image" content="{{ site.url }}/assets/img/og-default.png">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="{{ site.brand }}">
		<meta property="og:locale" content="en_US">
		{%- set _lastmod = lastmod[page.inputPath] or page.date.toISOString().split("T")[0] %}
		{%- set _datepublished = datepublished[page.inputPath] or _lastmod %}
		<meta property="article:modified_time" content="{{ _lastmod }}T00:00:00Z">
		<meta property="article:published_time" content="{{ _datepublished }}T00:00:00Z">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }} — {{ site.tagline }}{% endif %}">
		<meta name="twitter:description" content="{{ description or site.description }}">
		<meta name="twitter:image" content="{{ site.url }}/assets/img/og-default.png">
		<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
		<link rel="preload" href="/assets/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/assets/fonts/geist/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
		{#- Pages on the v2 design (the homepage, and any page using layouts/product.njk,
			which sets design: v2) load the v2 component sheet. Every other page still loads
			the legacy base overrides and the v1 components until it is migrated. -#}
		{%- set v2 = page.url === "/" or design === "v2" %}
		<link rel="stylesheet" href="/assets/css/tokens.css?v={{ assetVersion }}">
		<link rel="stylesheet" href="/assets/css/base.css?v={{ assetVersion }}">
		{%- if v2 %}
		<link rel="stylesheet" href="/assets/css/components-v2.css?v={{ assetVersion }}">
		{%- if article %}
		<link rel="stylesheet" href="/assets/css/article.css?v={{ assetVersion }}">
		{%- endif %}
		{%- if tools %}
		<link rel="stylesheet" href="/assets/css/tools.css?v={{ assetVersion }}">
		{%- endif %}
		{%- else %}
		<link rel="stylesheet" href="/assets/css/legacy.css?v={{ assetVersion }}">
		<link rel="stylesheet" href="/assets/css/components.css?v={{ assetVersion }}">
		{%- endif %}
		<link rel="stylesheet" href="/assets/css/shell.css?v={{ assetVersion }}">
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "{{ site.brand }}",
				"legalName": "{{ site.legalName }}",
				"url": "{{ site.url }}",
				"logo": "{{ site.url }}/assets/img/og-default.png",
				"description": "{{ site.description }}",
				"email": "{{ site.supportEmail }}",
				"address": [
					{%- for office in site.offices %}
					{
						"@type": "PostalAddress",
						"streetAddress": "{{ office.street }}",
						"addressLocality": "{{ office.city }}",
						"addressRegion": "{{ office.region }}",
						"postalCode": "{{ office.postalCode }}",
						"addressCountry": "US"
					}{% if not loop.last %},{% endif %}
					{%- endfor %}
				],
				"contactPoint": [
					{%- for office in site.offices %}
					{
						"@type": "ContactPoint",
						"telephone": "{{ office.phoneTel }}",
						"contactType": "customer service",
						"areaServed": "US",
						"availableLanguage": "en"
					}{% if not loop.last %},{% endif %}
					{%- endfor %}
				],
				"identifier": [
					{ "@type": "PropertyValue", "name": "FCC Filer ID", "value": "829231" },
					{ "@type": "PropertyValue", "name": "Robocall Mitigation Database ID", "value": "RMD0004909" },
					{ "@type": "PropertyValue", "name": "Operating Company Number", "value": "470J" }
				]
			}
		</script>
		{%- if page.url == "/" %}
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "{{ site.brand }}",
				"url": "{{ site.url }}",
				"description": "{{ site.description }}",
				"publisher": { "@type": "Organization", "name": "{{ site.brand }}" }
			}
		</script>
		{%- endif %}
		{% breadcrumbsJsonLd page.url, collections.all, site.url %}
		{% pageJsonLd page.url, page.inputPath, title, description, lastmod, datepublished, site %}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		{% include "partials/nav.njk" %}
		<main id="main">
			{{ content | safe }}
		</main>
		{% include "partials/footer.njk" %}
		<script type="module" src="/assets/js/nav.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/code-tabs.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/copy-to-clipboard.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/signup.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/pricing-calculator.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/faq.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/api-playground/main.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/voiceml-validator/main.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/credentials-bootstrap/main.js?v={{ assetVersion }}"></script>
		<script type="module" src="/assets/js/status-updated.js?v={{ assetVersion }}"></script>
	</body>
</html>
