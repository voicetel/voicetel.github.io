{#- Stacked flow rows ("lanes"), each with a heading, an optional note, and
	nodes joined by links. A link with `fail` is drawn as a broken path; a
	lane `loop` draws a dashed return path from its last node to its first.
	Lane offsets accumulate through array pushes because Nunjucks `set`
	inside a loop does not escape the loop scope. -#}
{%- set maxN = ill.lanes | maxCount("nodes") %}
{%- if variant === "wide" %}
{%- set gap = 80 %}
{%- set w = (984 - gap * (maxN - 1)) / maxN %}
{%- set h = 80 %}
{%- set tops = [8] %}
{%- for lane in ill.lanes %}{% set _ = tops.push(tops[loop.index0] + 152 + (56 if lane.loop else 0)) %}{% endfor %}
{%- for lane in ill.lanes %}
{%- set top = tops[loop.index0] %}
{%- set boxTop = top + 44 %}
{%- set mid = boxTop + h / 2 %}
{%- set n = lane.nodes | length %}
<text class="li-heading" x="8" y="{{ top + 14 }}">{{ lane.label }}</text>
{%- if lane.meta %}
<text class="li-meta" x="8" y="{{ top + 32 }}">{{ lane.meta }}</text>
{%- endif %}
{%- for node in lane.nodes %}
{%- set x = 8 + loop.index0 * (w + gap) %}
<rect class="li-node{% if node.accent %} li-node--accent{% endif %}" x="{{ x | round(1) }}" y="{{ boxTop }}" width="{{ w | round(1) }}" height="{{ h }}" rx="4"/>
{%- if node.accent %}
<rect class="li-accent" x="{{ x | round(1) }}" y="{{ boxTop }}" width="{{ w | round(1) }}" height="3"/>
{%- endif %}
<g class="li-icon" transform="translate({{ (x + 14) | round(1) }} {{ boxTop + 14 }}) scale(1.25)">{% icon node.icon %}</g>
<text class="li-label" x="{{ (x + 42) | round(1) }}" y="{{ boxTop + 30 }}">{{ node.label }}</text>
<text class="li-meta" x="{{ (x + 14) | round(1) }}" y="{{ boxTop + 60 }}">{{ node.meta }}</text>
{%- if not loop.last %}
{%- set link = lane.links[loop.index0] %}
{%- set x1 = x + w + 6 %}
{%- set x2 = x + w + gap - 6 %}
{%- if link.fail %}
<line class="li-line li-line--fail" x1="{{ x1 | round(1) }}" y1="{{ mid }}" x2="{{ x2 | round(1) }}" y2="{{ mid }}"/>
<circle class="li-fail-mark" cx="{{ ((x1 + x2) / 2) | round(1) }}" cy="{{ mid }}" r="8"/>
<text class="li-fail" x="{{ ((x1 + x2) / 2) | round(1) }}" y="{{ mid + 5 }}" text-anchor="middle">×</text>
{%- else %}
<line class="li-line" x1="{{ x1 | round(1) }}" y1="{{ mid }}" x2="{{ x2 | round(1) }}" y2="{{ mid }}" marker-end="url(#arrow)"{% if link.both %} marker-start="url(#arrow)"{% endif %}/>
{%- endif %}
{%- if link.label %}
<text class="li-link{% if link.fail %} li-link--fail{% endif %} li-halo" x="{{ ((x1 + x2) / 2) | round(1) }}" y="{{ mid - 13 if link.fail else mid - 9 }}" text-anchor="middle">{{ link.label }}</text>
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if lane.loop %}
{%- set xa = 8 + w / 2 %}
{%- set xb = 8 + (n - 1) * (w + gap) + w / 2 %}
<path class="li-line li-line--return" d="M{{ xb | round(1) }},{{ boxTop + h + 4 }} V{{ boxTop + h + 28 }} H{{ xa | round(1) }} V{{ boxTop + h + 6 }}" marker-end="url(#arrow)"/>
<text class="li-link" x="{{ ((xa + xb) / 2) | round(1) }}" y="{{ boxTop + h + 48 }}" text-anchor="middle">{{ lane.loop.label }}</text>
{%- endif %}
{%- endfor %}
{%- else %}
{%- set nx = 22 %}
{%- set nw = 290 %}
{%- set nh = 60 %}
{%- set vgap = 40 %}
{%- set tops = [8] %}
{%- for lane in ill.lanes %}
{%- set metaLines = (lane.meta | wrapText(36) | length) if lane.meta else 0 %}
{%- set loopLines = (lane.loop.label | wrapText(36) | length) if lane.loop else 0 %}
{%- set _ = tops.push(tops[loop.index0] + 28 + metaLines * 18 + (lane.nodes | length) * (nh + vgap) - vgap + (16 + loopLines * 17 if lane.loop else 0) + 28) %}
{%- endfor %}
{%- for lane in ill.lanes %}
{%- set top = tops[loop.index0] %}
{%- set metaLines = (lane.meta | wrapText(36)) if lane.meta else [] %}
{%- set first = top + 28 + (metaLines | length) * 18 %}
{%- set n = lane.nodes | length %}
{%- set lastTop = first + (n - 1) * (nh + vgap) %}
<text class="li-heading" x="8" y="{{ top + 14 }}">{{ lane.label }}</text>
{%- for line in metaLines %}
<text class="li-meta" x="8" y="{{ top + 33 + loop.index0 * 18 }}">{{ line }}</text>
{%- endfor %}
{%- for node in lane.nodes %}
{%- set y = first + loop.index0 * (nh + vgap) %}
<rect class="li-node{% if node.accent %} li-node--accent{% endif %}" x="{{ nx }}" y="{{ y }}" width="{{ nw }}" height="{{ nh }}" rx="4"/>
{%- if node.accent %}
<rect class="li-accent" x="{{ nx }}" y="{{ y }}" width="3" height="{{ nh }}"/>
{%- endif %}
<g class="li-icon" transform="translate({{ nx + 14 }} {{ y + 19 }}) scale(1.375)">{% icon node.icon %}</g>
<text class="li-label" x="{{ nx + 50 }}" y="{{ y + 26 }}">{{ node.label }}</text>
<text class="li-meta" x="{{ nx + 50 }}" y="{{ y + 45 }}">{{ node.meta }}</text>
{%- if not loop.last %}
{%- set link = lane.links[loop.index0] %}
{%- set cx = nx + nw / 2 %}
{%- if link.fail %}
<line class="li-line li-line--fail" x1="{{ cx }}" y1="{{ y + nh + 5 }}" x2="{{ cx }}" y2="{{ y + nh + vgap - 5 }}"/>
<circle class="li-fail-mark" cx="{{ cx }}" cy="{{ y + nh + vgap / 2 }}" r="8"/>
<text class="li-fail" x="{{ cx }}" y="{{ y + nh + vgap / 2 + 5 }}" text-anchor="middle">×</text>
{%- else %}
<line class="li-line" x1="{{ cx }}" y1="{{ y + nh + 5 }}" x2="{{ cx }}" y2="{{ y + nh + vgap - 5 }}" marker-end="url(#arrow)"{% if link.both %} marker-start="url(#arrow)"{% endif %}/>
{%- endif %}
{%- if link.label %}
<text class="li-link{% if link.fail %} li-link--fail{% endif %}" x="{{ cx + (16 if link.fail else 12) }}" y="{{ y + nh + vgap / 2 + 4 }}">{{ link.label }}</text>
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if lane.loop %}
<path class="li-line li-line--return" d="M{{ nx }},{{ lastTop + nh / 2 }} H8 V{{ first + nh / 2 }} H{{ nx - 3 }}" marker-end="url(#arrow)"/>
{%- for line in lane.loop.label | wrapText(36) %}
<text class="li-link" x="{{ nx }}" y="{{ lastTop + nh + 24 + loop.index0 * 17 }}">{{ line }}</text>
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
