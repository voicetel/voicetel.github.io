              recordingStatusCallbackEvent="completed"/>
      <Say>Thank you. Goodbye.</Say>
      <Hangup/>

    {% else %}
      <Say>That is not a valid option. Goodbye.</Say>
      <Hangup/>
    {% endif %}
  {% endif %}
</Response>
